pipeline {
	agent any

	tools {
		nodejs 'LTS v20.x'
	}

	stages {
		stage('Install') {
			steps {
				sh 'npm install'
			}
		}

		stage('Build') {
			steps {
				sh 'npm run build'
			}
		}

		stage('Test') {
			steps {
				sh 'npm test'
			}
			post {
				always {
					junit 'junit.xml'
				}
			}
		}

		stage('Deploy') {
			steps {
				script {
					docker.build('zhennue111/node-app:latest')
					docker.withRegistry('https://registry.hub.docker.com', 'docker-hub-creds') {
						docker.image('zhennue111/node-app:latest').push()
					}
				}
			}
		}
	}
}