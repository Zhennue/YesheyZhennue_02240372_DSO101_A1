pipeline {
    agent any
    tools {
        nodejs 'LTS v20.x'
    }
    stages {

        stage('Checkout') {
            steps {
                git branch: 'main',
                    credentialsId: 'Zhennue',
                    url: 'https://github.com/Zhennue/YesheyZhennue_02240372_DSO101_A1'
            }
        }

        stage('Install') {
            steps {
                dir('be') {
                    bat 'npm install'
                }
            }
        }

        stage('Build') {
            steps {
                dir('be') {
                    bat 'npm run build'
                }
            }
        }

        stage('Test') {
            steps {
                dir('be') {
                    bat 'npm run build'
                }
            }
            post {
                always {
                    echo 'No backend test suite is defined; build was used as the verification step.'
                }
            }
        }

        stage('Deploy') {
            steps {
                echo 'App is deployed on Render.com via GitHub auto-deploy'
                echo 'Backend: https://yesheyzhennue-02240372-dso101-a1.onrender.com'
                echo 'Frontend: https://yesheyzhennue-02240372-dso101-a1-jeng.onrender.com'
            }
        }
    }

    post {
        success {
            echo 'Pipeline completed successfully!'
        }
        failure {
            echo 'Pipeline failed. Check the logs above.'
        }
    }
}
