pipeline {
	agent any

	tools {
		nodejs 'LTS v20.x'
	}

	stages {
		stage('Install') {
			steps {
				dir('fe') {
					bat 'npm install'
				}
			}
		}

		stage('Build') {
			steps {
				dir('fe') {
					bat 'npm run build'
				}
			}
		}

		stage('Test') {
			steps {
				dir('fe') {
					bat 'npm test'
				}
			}
			post {
				always {
					junit allowEmptyResults: true, testResults: 'fe/junit.xml'
				}
			}
		}

		stage('Deploy') {
			steps {
				script {
					dir('fe') {
						docker.build('zhennue111/fe-todo:latest')
						docker.withRegistry('https://registry.hub.docker.com', 'docker-hub-creds') {
							docker.image('zhennue111/fe-todo:latest').push()
						}
					}
				}
			}
		}
	}
}